meta {
  name: List Tamu by Undangan
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/tamu/undangan/:undanganId
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:query {
  page: 1
  limit: 10
  search:
  sortBy: createdAt
  order: desc
  sendStatus:
  isRead:
  isConfirm:
  isAttend:
}

docs {
  # List Tamu by Undangan

  Daftar tamu undangan dengan pagination dan filter.

  | Param      | Description                                  |
  |------------|----------------------------------------------|
  | sendStatus | Filter status kirim WhatsApp (0/1)           |
  | isRead     | Filter sudah dibuka atau belum (0/1)         |
  | isConfirm  | Filter sudah RSVP via halaman publik (0/1)   |
  | isAttend   | Filter sudah absen fisik via scanner (0/1)   |
}
